# Python files and directories - ignore ALL Python in root directory
# This prevents Vercel from detecting Python and attempting to compile packages
*.py
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv

# Backend files
api/
api_simple.py
requirements.txt
requirements-backend.txt
Dockerfile
docker-compose.yml
render.yaml

# Development files
.env
.env.local
.env.*.local

# Test files
test_*.py
*_test.py
